{
	"name": "obsidian-rechner-plugin",
	"version": "0.8.0",
	"description": "Obsidian frontend for WebAssembly based calculator engines",
	"main": "main.js",
	"scripts": {
		"wasm": "RUSTFLAGS='--cfg getrandom_backend=\"wasm_js\"' wasm-pack build --target=web ./kernels/numbat-kernel --release",
		"dev": "NODE_ENV=development vite build --mode development --watch",
		"build": "tsc -noEmit -skipLibCheck && vite build --mode production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
		"prepare-lezer": "lezer-generator src/numbat-lang/numbat.grammar -o src/numbat-lang/NumbatParser.js"
	},
	"type": "module",
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lezer/generator": "^1.8.1",
		"@types/node": "^20.19.43",
		"@vitejs/devtools": "^0.7.6",
		"builtin-modules": "3.3.0",
		"eslint": "^10.12.0",
		"eslint-plugin-obsidianmd": "latest",
		"eslint-plugin-promise": "^7.3.0",
		"globals": "^17.13.0",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1",
		"vite-plugin-inspect": "12.0.0-beta.1",
		"vite-plugin-wasm": "^3.6.0"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/language": "^6.13.1",
		"@lezer/highlight": "^1.2.5",
		"@lezer/lr": "^1.4.11",
		"numbat-kernel": "link:kernels/numbat-kernel/pkg",
		"vite": "^8.3.4"
	},
	"peerDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6"
	}
}
